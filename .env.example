# GMI-01 — Configuration d'environnement client
# IMPORTANT : Ne jamais renseigner ici de clé secrète service_role !
# Seule la clé publique anonyme (anon key) doit être fournie au frontend.

# URL de votre projet Supabase (ex: https://abcdefghijklm.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Clé publique anonyme Supabase (Anon / Publishable Key)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here
